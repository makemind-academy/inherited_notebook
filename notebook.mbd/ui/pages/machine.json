{
  "type": "page",
  "metadata": {
    "title": "Everything written down"
  },
  "onInit": {
    "type": "tool",
    "tool": "notes.machine",
    "params": {}
  },
  "state": {
    "initial": {
      "rows": [],
      "rowCount": 0,
      "writers": "",
      "span": "",
      "supersededCount": 0,
      "noOutcomeCount": 0,
      "headline": "",
      "bookRule": ""
    }
  },
  "content": {
    "type": "container",
    "decoration": {
      "color": "{{theme.color.surfaceContainerHighest}}"
    },
    "child": {
      "type": "linear",
      "direction": "vertical",
      "children": [
        {
          "type": "container",
          "padding": {
            "left": 22,
            "right": 22,
            "top": 20,
            "bottom": 16
          },
          "decoration": {
            "color": "{{theme.color.surface}}",
            "border": {
              "bottom": true,
              "color": "{{theme.color.outline}}",
              "width": 1
            }
          },
          "child": {
            "type": "linear",
            "direction": "horizontal",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "linear",
                "direction": "vertical",
                "children": [
                  {
                    "type": "text",
                    "content": "LINE 2 PRESS · {{span}} · {{writers}}",
                    "style": {
                      "fontSize": 12,
                      "color": "{{theme.color.onSurfaceVariant}}",
                      "letterSpacing": 1.4
                    }
                  },
                  {
                    "type": "text",
                    "content": "Everything written down",
                    "style": {
                      "fontSize": 21,
                      "color": "{{theme.color.onSurface}}",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "gap": 4
              },
              {
                "type": "spacer"
              },
              {
                "type": "linear",
                "direction": "vertical",
                "children": [
                  {
                    "type": "text",
                    "content": "ENTRIES",
                    "style": {
                      "fontSize": 11,
                      "color": "{{theme.color.onSurfaceVariant}}",
                      "letterSpacing": 1.6
                    }
                  },
                  {
                    "type": "text",
                    "content": "{{rowCount}}",
                    "style": {
                      "fontSize": 26,
                      "color": "{{theme.color.onSurface}}",
                      "fontFamily": "JetBrainsMono"
                    }
                  }
                ],
                "gap": 4,
                "crossAxisAlignment": "end"
              }
            ]
          }
        },
        {
          "type": "container",
          "padding": {
            "left": 24,
            "right": 24,
            "top": 10,
            "bottom": 4
          },
          "child": {
            "type": "linear",
            "direction": "horizontal",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "button",
                "label": "What still stands →",
                "variant": "outlined",
                "onTap": {
                  "type": "navigation",
                  "action": "push",
                  "route": "/standing"
                }
              }
            ]
          }
        },
        {
          "type": "expanded",
          "child": {
            "type": "container",
            "padding": {
              "left": 22,
              "right": 22,
              "top": 16,
              "bottom": 8
            },
            "child": {
              "type": "container",
              "padding": {
                "all": 18
              },
              "decoration": {
                "color": "{{theme.color.surface}}",
                "borderRadius": 14,
                "border": {
                  "color": "{{theme.color.outline}}",
                  "width": 1
                }
              },
              "child": {
                "type": "list",
                "items": "{{rows}}",
                "shrinkWrap": true,
                "itemSpacing": 10,
                "emptyMessage": "Nothing written down for this machine",
                "itemTemplate": {
                  "type": "linear",
                  "direction": "vertical",
                  "gap": 2,
                  "children": [
                    {
                      "type": "linear",
                      "direction": "horizontal",
                      "crossAxisAlignment": "center",
                      "children": [
                        {
                          "type": "container",
                          "width": 56,
                          "alignment": "centerStart",
                          "child": {
                            "type": "text",
                            "content": "{{item.year}}",
                            "textAlign": "start",
                            "maxLines": 1,
                            "style": {
                              "fontSize": 14,
                              "color": "{{theme.color.primary}}",
                              "textAlign": "start",
                              "fontFamily": "JetBrainsMono"
                            }
                          }
                        },
                        {
                          "type": "container",
                          "width": 70,
                          "alignment": "centerStart",
                          "child": {
                            "type": "text",
                            "content": "{{item.who}}",
                            "textAlign": "start",
                            "maxLines": 1,
                            "style": {
                              "fontSize": 13,
                              "color": "{{theme.color.onSurfaceVariant}}",
                              "textAlign": "start",
                              "fontFamily": "JetBrainsMono"
                            }
                          }
                        },
                        {
                          "type": "expanded",
                          "child": {
                            "type": "text",
                            "content": "{{item.outcome}}",
                            "maxLines": 1,
                            "style": {
                              "fontSize": 13,
                              "color": "{{theme.color.onSurface}}",
                              "fontFamily": "JetBrainsMono"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "type": "container",
                      "padding": {
                        "left": 56
                      },
                      "child": {
                        "type": "text",
                        "content": "{{item.correctedBy}}",
                        "style": {
                          "fontSize": 12,
                          "color": "{{theme.color.warning}}"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "type": "container",
          "padding": {
            "left": 22,
            "right": 22,
            "top": 0,
            "bottom": 8
          },
          "child": {
            "type": "container",
            "padding": {
              "all": 18
            },
            "decoration": {
              "color": "{{theme.color.surface}}",
              "borderRadius": 14,
              "border": {
                "color": "{{theme.color.outline}}",
                "width": 1
              }
            },
            "child": {
              "type": "linear",
              "direction": "horizontal",
              "crossAxisAlignment": "center",
              "children": [
                {
                  "type": "linear",
                  "direction": "vertical",
                  "children": [
                    {
                      "type": "text",
                      "content": "SUPERSEDED",
                      "style": {
                        "fontSize": 11,
                        "color": "{{theme.color.onSurfaceVariant}}",
                        "letterSpacing": 1.6
                      }
                    },
                    {
                      "type": "text",
                      "content": "{{supersededCount}}",
                      "style": {
                        "fontSize": 18,
                        "color": "{{theme.color.warning}}",
                        "fontFamily": "JetBrainsMono"
                      }
                    }
                  ],
                  "gap": 4
                },
                {
                  "type": "container",
                  "padding": {
                    "left": 36,
                    "right": 0,
                    "top": 0,
                    "bottom": 0
                  },
                  "child": {
                    "type": "linear",
                    "direction": "vertical",
                    "children": [
                      {
                        "type": "text",
                        "content": "NO OUTCOME WRITTEN",
                        "style": {
                          "fontSize": 11,
                          "color": "{{theme.color.onSurfaceVariant}}",
                          "letterSpacing": 1.6
                        }
                      },
                      {
                        "type": "text",
                        "content": "{{noOutcomeCount}}",
                        "style": {
                          "fontSize": 18,
                          "color": "{{theme.color.onSurface}}",
                          "fontFamily": "JetBrainsMono"
                        }
                      }
                    ],
                    "gap": 4
                  }
                },
                {
                  "type": "spacer"
                },
                {
                  "type": "text",
                  "content": "{{headline}}",
                  "style": {
                    "fontSize": 14,
                    "color": "{{theme.color.onSurface}}"
                  }
                }
              ]
            }
          }
        },
        {
          "type": "container",
          "padding": {
            "left": 22,
            "right": 22,
            "top": 4,
            "bottom": 18
          },
          "child": {
            "type": "linear",
            "direction": "horizontal",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "text",
                "content": "{{bookRule}}",
                "style": {
                  "fontSize": 13,
                  "color": "{{theme.color.onSurfaceVariant}}"
                }
              }
            ]
          }
        }
      ],
      "crossAxisAlignment": "stretch"
    }
  }
}
